          "editorMode": "code",
          "expr": "avg(uvmp:vm:cpu_percent{idc=~\"$idc\", instance=~\"$host\", biz1=~\"$biz1\", biz2=~\"$biz2\"})",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "平均 CPU 使用率",
      "type": "stat"
    },
